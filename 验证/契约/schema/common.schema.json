          "properties": {
            "object_type": {
              "enum": [
                "CourseVersion",
                "ProgramVersion",
                "LearningActivity",
                "Framework",
                "Resource",
                "RightsRecord",
                "AssessmentItem",
                "AssessmentPlan",
