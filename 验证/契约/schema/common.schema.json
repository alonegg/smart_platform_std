          "x-target-types": [
            "AccessGrant"
          ]
        },
        "credential_digest": {
          "$ref": "#/$defs/Sha256"
        },
        "access_mode": {
          "enum": [
            "user_session",
            "delegated",
            "client_credentials"
          ]
        },
        "on_behalf_of_ref": {
          "$ref": "#/$defs/NonVersionedRef",
          "properties": {
            "object_type": {
              "enum": [
                "Person"
              ]
            }
          },
          "x-target-types": [
            "Person"
          ]
        },
        "delegation_grant_ref": {
          "$ref": "#/$defs/IndependentRef",
          "properties": {
            "object_type": {
              "enum": [
                "AccessGrant"
              ]
            }
          },
          "x-target-types": [
            "AccessGrant"
          ]
        }
      },
      "required": [
        "client_id",
        "grant_ref",
        "credential_digest",
        "access_mode"
      ],
      "additionalProperties": false,
      "x-assumption": [
        "H-04"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "access_mode": {
                "const": "delegated"
              }
            }
          },
          "then": {
            "required": [
              "on_behalf_of_ref",
              "delegation_grant_ref"
            ]
          }
        }
      ],
      "x-hint": "填写 client_id/grant_ref/credential_digest/access_mode；delegated 还需人员与委托授权引用。"
    },
