    "ObjectRef": {
      "x-rule-id": "R-REF-003",
      "x-clause": "5.1.3",
      "type": "object",
      "required": [
        "object_type"
      ],
      "properties": {
        "object_type": {
          "$ref": "#/$defs/ObjectType"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "object_type": {
                "enum": [
                  "CourseVersion",
                  "ProgramVersion",
                  "LearningActivity",
                  "Framework",
                  "Resource",
                  "RightsRecord",
                  "AssessmentItem",
                  "AssessmentPlan",
                  "Rubric",
                  "Scale",
                  "MethodRegistration",
                  "MethodApproval",
                  "CapabilityRegistration",
                  "AccessGrant",
                  "AccessPolicy",
                  "DataClassification"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/IndependentRef"
          }
        },
        {
          "if": {
            "properties": {
              "object_type": {
                "enum": [
                  "LearningUnit",
                  "LearningObjective",
                  "KnowledgePoint",
                  "Competency",
                  "ProgramAlignment",
                  "Segment",
                  "RubricCriterion"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/EmbeddedRef"
          }
        },
        {
          "if": {
            "properties": {
              "object_type": {
                "enum": [
                  "AssessmentAdjustment",
                  "LearningEvent",
                  "ProcessArtifact",
                  "Submission",
                  "HelpRecord",
                  "Feedback",
                  "GradeDecision",
                  "PeerReview",
                  "ObservationRecord",
                  "CognitiveState",
                  "LearningRecommendation"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/RecordRef"
          }
        },
        {
          "if": {
            "properties": {
              "object_type": {
                "enum": [
                  "Person",
                  "Organization",
                  "AcademicSession",
                  "Course",
                  "Offering",
                  "Enrollment",
                  "EnrollmentRound",
                  "TaskAttempt",
                  "TeachingAssignment",
                  "LearnerGroup",
                  "ApplicationInstance"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/NonVersionedRef"
          }
        },
        {
          "if": {
            "properties": {
              "object_type": {
                "const": "EvidenceLink"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/EmbeddedInRecordRef"
          }
        }
      ],
      "x-hint": "ObjectRef 必须携带 object_type，并按该类型的版本化分类填写版本或所有者。"
    },
    "MissingReasons": {
      "x-rule-id": "R-MISSING-001",
      "x-clause": "5.5.5",
      "type": "array",
      "x-assumption": [
        "H-03"
      ],
      "items": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
          },
          "reason": {
            "enum": [
              "unknown",
              "not_collected",
              "not_authorized",
              "source_unsupported",
              "not_applicable"
            ]
          },
          "rule_id": {
            "$ref": "#/$defs/Identifier"
          },
          "adjustment_ref": {
            "$ref": "#/$defs/RecordRef",
            "properties": {
              "object_type": {
                "enum": [
                  "AssessmentAdjustment"
                ]
              }
            },
            "x-target-types": [
              "AssessmentAdjustment"
            ]
          }
        },
        "required": [
          "pointer",
          "reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "not_applicable"
                }
              }
            },
            "then": {
              "required": [
                "rule_id"
              ]
            }
          }
        ]
      },
      "x-hint": "为缺失值填写 pointer/reason；not_applicable 还必须提供适用性 rule_id。"
    },
    "AuthContext": {
      "x-rule-id": "R-AUTH-001",
      "x-clause": "5.3.3",
      "type": "object",
      "properties": {
        "client_id": {
          "$ref": "#/$defs/Identifier"
        },
        "grant_ref": {
          "$ref": "#/$defs/IndependentRef",
          "properties": {
            "object_type": {
              "enum": [
                "AccessGrant"
