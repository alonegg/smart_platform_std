{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/smart-teaching/contracts/0.1.0-candidate/schema/objects/AssessmentPlan.schema.json",
  "x-clause": "6.6.3；6.6.4",
  "x-elements": [
    "OBJ-024"
  ],
  "x-assumption": [
    "H-22",
    "H-14"
  ],
  "x-rule-id": "R-ASSESSMENTPLAN-001",
  "x-hint": "补齐 components、calculation_rule_ref、retake_rules、group_scoring、peer_weight、peer_calibration、submission_selection；公共身份、来源、权利与保护字段同样必填，删除未注册核心成员。",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/IndependentBase"
    },
    {
      "type": "object",
      "properties": {
        "object_type": {
          "const": "AssessmentPlan"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "component_id": {
                "$ref": "../common.schema.json#/$defs/Identifier"
              },
              "is_exam": {
                "type": "boolean"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "objective_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "../common.schema.json#/$defs/ObjectRef",
                  "x-target-types": [
                    "LearningObjective"
                  ],
                  "properties": {
                    "object_type": {
                      "enum": [
                        "LearningObjective"
                      ]
                    }
                  }
                }
              },
              "evidence_form": {
                "enum": [
                  "数字作品",
                  "现场表现",
                  "校外评价"
                ]
              },
              "evidence_kind": {
                "enum": [
                  "direct",
                  "indirect"
                ]
              },
              "evaluators": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "教师",
                    "助教",
                    "同伴",
                    "校外评价人",
                    "自动评分"
                  ]
                }
              },
              "deadline": {
                "$ref": "../common.schema.json#/$defs/Timestamp"
              },
              "late_window_end": {
                "$ref": "../common.schema.json#/$defs/Timestamp"
              },
              "discussion_weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "attendance_weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "component_id",
              "is_exam",
              "weight",
              "objective_refs",
              "evidence_form",
              "evidence_kind",
              "evaluators"
            ],
            "additionalProperties": false
          }
        },
        "calculation_rule_ref": {
          "$ref": "../common.schema.json#/$defs/ObjectRef",
          "x-target-types": [
            "MethodRegistration"
          ],
          "properties": {
            "object_type": {
              "enum": [
                "MethodRegistration"
              ]
            }
          }
        },
        "retake_rules": {
          "type": "string",
          "minLength": 1
        },
        "group_scoring": {
          "enum": [
            "组分加个人贡献调整",
            "个人部分单独评价",
            "仅组分"
          ]
        },
        "peer_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "peer_calibration": {
          "type": "string",
          "minLength": 1
        },
        "deadline_basis": {
          "type": "string",
          "minLength": 1
        },
        "grace_rules": {
          "type": "string",
          "minLength": 1
        },
        "submission_selection": {
          "enum": [
            "last",
            "highest",
            "teacher_selected"
          ]
        },
        "withdrawal_allowed": {
          "type": "boolean"
        },
        "withdrawal_deadline": {
          "$ref": "../common.schema.json#/$defs/Timestamp"
        }
      },
      "required": [
        "components",
        "calculation_rule_ref",
        "retake_rules",
        "group_scoring",
        "peer_weight",
        "peer_calibration",
        "submission_selection"
      ],
      "allOf": [
        {
          "x-rule-id": "R-ASSESSMENTPLAN-002",
          "x-clause": "6.6.3 l)",
          "x-hint": "允许撤回时必须声明撤回截止时间。",
          "if": {
            "properties": {
              "withdrawal_allowed": {
                "const": true
              }
            },
            "required": [
              "withdrawal_allowed"
            ]
          },
          "then": {
            "required": [
              "withdrawal_deadline"
            ]
          }
        }
      ]
    }
  ],
  "unevaluatedProperties": false
}
