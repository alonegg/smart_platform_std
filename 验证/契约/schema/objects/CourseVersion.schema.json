{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/smart-teaching/contracts/0.1.0-candidate/schema/objects/CourseVersion.schema.json",
  "x-clause": "5.2.1；6.1.1；6.1.3",
  "x-elements": [
    "OBJ-005"
  ],
  "x-assumption": [
    "H-16",
    "H-14"
  ],
  "x-rule-id": "R-COURSEVERSION-001",
  "x-hint": "补齐 course_ref、objective_refs、assessment_plan_ref、course_profile；公共身份、来源、权利与保护字段同样必填，删除未注册核心成员。",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/IndependentBase"
    },
    {
      "type": "object",
      "properties": {
        "object_type": {
          "const": "CourseVersion"
        },
        "course_ref": {
          "$ref": "../common.schema.json#/$defs/ObjectRef",
          "x-target-types": [
            "Course"
          ],
          "properties": {
            "object_type": {
              "enum": [
                "Course"
              ]
            }
          }
        },
        "objective_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../common.schema.json#/$defs/ObjectRef",
            "x-target-types": [
              "LearningObjective"
            ],
            "properties": {
              "object_type": {
                "enum": [
                  "LearningObjective"
                ]
              }
            }
          }
        },
        "assessment_plan_ref": {
          "$ref": "../common.schema.json#/$defs/ObjectRef",
          "x-target-types": [
            "AssessmentPlan"
          ],
          "properties": {
            "object_type": {
              "enum": [
                "AssessmentPlan"
              ]
            }
          }
        },
        "syllabus_ref": {
          "$ref": "../common.schema.json#/$defs/ObjectRef",
          "x-target-types": [
            "Resource"
          ],
          "properties": {
            "object_type": {
              "enum": [
                "Resource"
              ]
            }
          }
        },
        "unit_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../common.schema.json#/$defs/ObjectRef",
            "x-target-types": [
              "LearningUnit"
            ],
            "properties": {
              "object_type": {
                "enum": [
                  "LearningUnit"
                ]
              }
            }
          }
        },
        "resource_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../common.schema.json#/$defs/ObjectRef",
            "x-target-types": [
              "Resource"
            ],
            "properties": {
              "object_type": {
                "enum": [
                  "Resource"
                ]
              }
            }
          }
        },
        "activity_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../common.schema.json#/$defs/ObjectRef",
            "x-target-types": [
              "LearningActivity"
            ],
            "properties": {
              "object_type": {
                "enum": [
                  "LearningActivity"
                ]
              }
            }
          }
        },
        "course_profile": {
          "enum": [
            "基础",
            "达成度",
            "精细诊断"
          ]
        }
      },
      "required": [
        "course_ref",
        "objective_refs",
        "assessment_plan_ref",
        "course_profile"
      ],
      "allOf": [
        {
          "x-rule-id": "R-COURSEVERSION-002",
          "x-clause": "6.1.1",
          "x-hint": "已发布课程版本须声明大纲、单元、资源和学习活动。",
          "if": {
            "properties": {
              "lifecycle_status": {
                "const": "published"
              }
            },
            "required": [
              "lifecycle_status"
            ]
          },
          "then": {
            "required": [
              "syllabus_ref",
              "unit_refs",
              "resource_refs",
              "activity_refs"
            ]
          }
        }
      ]
    }
  ],
  "unevaluatedProperties": false
}
