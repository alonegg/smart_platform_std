          "x-rule-id": "R-COG-005",
          "x-clause": "10.6.5",
          "x-hint": "unknown 的证据应为未审查的 null 或已核查无可用证据的空数组。",
          "if": {
            "properties": {
              "estimate_status": {
                "const": "unknown"
              }
            },
            "required": [
              "estimate_status"
            ]
