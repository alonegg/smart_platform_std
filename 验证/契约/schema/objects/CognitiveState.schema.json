          "x-rule-id": "R-COG-002",
          "x-clause": "10.3；10.6.1",
          "x-hint": "未知或证据不足时 value 必须显式为 null，并在 missing_reasons 登记 /value 的原因。",
          "if": {
            "properties": {
              "estimate_status": {
