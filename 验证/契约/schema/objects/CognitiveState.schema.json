          "x-rule-id": "R-COG-006",
          "x-clause": "10.3.1；10.6.5",
          "x-hint": "已估计或证据不足必须逐项列出至少一条经审查的证据关联。",
          "if": {
            "properties": {
              "estimate_status": {
                "enum": [
                  "estimated",
                  "insufficient_evidence"
