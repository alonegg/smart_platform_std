{
  "name": "smart-platform-stds-r2",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "main": "server/worker.mjs",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "r2.stds.chunlin.ch", "custom_domain": true }],
  "d1_databases": [{
    "binding": "READERS_DB",
    "database_name": "smart-platform-stds-r2-readers",
    // 由 wrangler d1 create 生成后填入；不得使用生产 D1 的 id。
    "database_id": "REPLACE_WITH_R2_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "REGISTRATION_LIMITER",
    "namespace_id": "2026112002",
    "simple": { "limit": 10, "period": 60 }
  }],
  "vars": {
    "PORTAL_EDITION": "r2",
    "PUBLICATION_PAUSED": "false",
    "REQUIRE_ACCESS": "true",
    "ADMIN_EMAIL": "alone@swufe.edu.cn",
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_R2_ACCESS_AUD"
  },
  "triggers": { "crons": ["15 2 * * *"] },
  "observability": { "enabled": false }
}
