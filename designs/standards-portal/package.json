{
  "name": "smart-platform-standards-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4311",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4311",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "wrangler dev --port 4320 --local --persist-to ../../temp/registration-local --infer-origin-from-routes=false"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "marked": "18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  }
}
