{
  "name": "smart-platform-stds",
  "account_id": "8937d4abe2c393f4227393a216b3c647",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // All static paths must pass through the publication gate.
    "run_worker_first": true,
  },
  "routes": [
    {
      "pattern": "stds.chunlin.ch",
      "custom_domain": true,
    },
  ],
  "main": "server/worker.mjs",
  "d1_databases": [
    {
      "binding": "READERS_DB",
      "database_name": "smart-platform-stds-readers",
      "database_id": "b6534aba-ba46-4ec7-9d1a-d127b660c9a2",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "REGISTRATION_LIMITER",
      "namespace_id": "2026110801",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "vars": {
    "PUBLICATION_PAUSED": "true",
    "ADMIN_EMAIL": "alone@swufe.edu.cn",
    "ACCESS_TEAM_DOMAIN": "paperdaily.cloudflareaccess.com",
    "ACCESS_AUD": "3032fc2149100501eb85b2dad0d02997618a64e9c06845ccf374b44eb7409679",
  },
  "triggers": {
    "crons": ["15 2 * * *"],
  },
  "observability": {
    "enabled": false,
  },
}
